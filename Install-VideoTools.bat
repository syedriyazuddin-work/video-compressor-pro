<# :
@echo off
title Video Converter & Compressor Pro - Setup / Updater
setlocal
powershell -NoProfile -ExecutionPolicy Bypass -Command "$installerBat = '%~f0'; iex ((Get-Content -Path '%~f0' -Raw))"
exit /b %errorlevel%
#>

$Host.UI.RawUI.WindowTitle = "Video Compressor & Converter Pro - Setup / Updater"

Write-Host "======================================================================" -ForegroundColor Cyan
Write-Host "         VIDEO COMPRESSOR & CONVERTER PRO - INSTALLER & UPDATER       " -ForegroundColor Yellow
Write-Host "======================================================================" -ForegroundColor Cyan
Write-Host ""

$installDir = "$env:LOCALAPPDATA\VideoTools"
Write-Host "Target Installation Directory: $installDir" -ForegroundColor Cyan

# Close existing running instance if open during update
Stop-Process -Name "VideoCompressorUI" -Force -ErrorAction SilentlyContinue
Start-Sleep -Milliseconds 300

if (-not (Test-Path "$installDir\bin")) { New-Item -ItemType Directory -Path "$installDir\bin" -Force | Out-Null }
if (-not (Test-Path "$installDir\scripts")) { New-Item -ItemType Directory -Path "$installDir\scripts" -Force | Out-Null }

Write-Host "`n[1/3] Extracting Desktop Application & tools..." -ForegroundColor White
$raw = (Get-Content -Path $installerBat -Raw)
$marker = '__PAYLOAD_ARCHIVE_DATA__'
$idx = $raw.LastIndexOf($marker)
if ($idx -lt 0) {
    Write-Host "[ERROR] Embedded payload marker not found!" -ForegroundColor Red
    Read-Host "Press Enter to exit..."
    exit 1
}

$payloadB64 = ($raw.Substring($idx + $marker.Length) -replace '[^A-Za-z0-9+/=]', '')
$bytes = [Convert]::FromBase64String($payloadB64)
$tempZip = Join-Path $env:TEMP "vt_payload_$([System.Guid]::NewGuid().ToString('N')).zip"
[System.IO.File]::WriteAllBytes($tempZip, $bytes)
Expand-Archive -Path $tempZip -DestinationPath $installDir -Force
Remove-Item -Force $tempZip -ErrorAction SilentlyContinue
Write-Host "      [OK] Video Compressor Pro App unpacked to $installDir" -ForegroundColor Green

Write-Host "`n[2/3] Checking FFmpeg engine..." -ForegroundColor White
$binFfmpeg = Join-Path $installDir "bin\ffmpeg.exe"
$binProbe = Join-Path $installDir "bin\ffprobe.exe"

if (-not (Test-Path $binFfmpeg)) {
    # Check if system has it
    $sysFfmpeg = Get-Command ffmpeg -ErrorAction SilentlyContinue
    if ($sysFfmpeg -and (Test-Path $sysFfmpeg.Source)) {
        Write-Host "      [+] Found existing FFmpeg on computer: $($sysFfmpeg.Source)" -ForegroundColor Green
        Copy-Item $sysFfmpeg.Source -Destination $binFfmpeg -Force
        $sysProbe = Get-Command ffprobe -ErrorAction SilentlyContinue
        if ($sysProbe -and (Test-Path $sysProbe.Source)) {
            Copy-Item $sysProbe.Source -Destination $binProbe -Force
        }
    }
}

if (-not (Test-Path $binFfmpeg)) {
    Write-Host "      [*] Downloading portable FFmpeg Essentials (~100 MB)..." -ForegroundColor Cyan
    Write-Host "      (This only downloads once so the app runs 100% offline & fast)" -ForegroundColor Gray
    $zip = Join-Path $env:TEMP "ffmpeg_dl_$([System.Guid]::NewGuid().ToString('N')).zip"
    $tmp = Join-Path $env:TEMP "ffmpeg_ext_$([System.Guid]::NewGuid().ToString('N'))"
    try {
        curl.exe -L -o $zip "https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip"
        Expand-Archive -Path $zip -DestinationPath $tmp -Force
        $inner = Get-ChildItem -Path $tmp -Directory | Select-Object -First 1
        Copy-Item "$($inner.FullName)\bin\ffmpeg.exe" -Destination $binFfmpeg -Force
        Copy-Item "$($inner.FullName)\bin\ffprobe.exe" -Destination $binProbe -Force
        Remove-Item -Force $zip -ErrorAction SilentlyContinue
        Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue
        Write-Host "      [OK] FFmpeg engine installed successfully!" -ForegroundColor Green
    } catch {
        Write-Host "      [ERROR] Could not download FFmpeg automatically: $_" -ForegroundColor Red
    }
} else {
    Write-Host "      [OK] FFmpeg engine is ready." -ForegroundColor Green
}

Write-Host "`n[3/3] Updating Desktop and Explorer shortcuts..." -ForegroundColor White
$desktop = [Environment]::GetFolderPath("Desktop")
$WshShell = New-Object -ComObject WScript.Shell

# Desktop App Shortcut
$appShortcut = $WshShell.CreateShortcut("$desktop\Video Compressor Pro.lnk")
$appShortcut.TargetPath = "$installDir\VideoCompressorUI.exe"
$appShortcut.WorkingDirectory = $installDir
$appShortcut.Description = "Video Compressor & Converter Pro (Desktop App)"
$appShortcut.IconLocation = "shell32.dll,137"
$appShortcut.Save()
Write-Host "      [+] Desktop Shortcut: 'Video Compressor Pro' (Modern Desktop App)" -ForegroundColor Green

# Remove legacy separate drop shortcut if present
$oldDrop = Join-Path $desktop "Compress Video (Drop Here).lnk"
if (Test-Path $oldDrop) { Remove-Item -Force $oldDrop -ErrorAction SilentlyContinue }

# Register Right-Click menu for video files and clean SendTo
powershell -ExecutionPolicy Bypass -File "$installDir\scripts\install_sendto_shortcuts.ps1" -NoPause

Write-Host "`n======================================================================" -ForegroundColor Green
Write-Host "                  SETUP / UPDATE COMPLETED SUCCESSFULLY!              " -ForegroundColor Yellow
Write-Host "======================================================================" -ForegroundColor Green

$verified = $true
if (Test-Path "$installDir\VideoCompressorUI.exe") {
    Write-Host "  [OK] Video Compressor Pro App verified in $installDir" -ForegroundColor Green
} else {
    Write-Host "  [ERROR] VideoCompressorUI.exe missing!" -ForegroundColor Red
    $verified = $false
}

if (Test-Path $binFfmpeg) {
    Write-Host "  [OK] FFmpeg conversion engine is ready." -ForegroundColor Green
} else {
    Write-Host "  [WARNING] FFmpeg engine not found yet." -ForegroundColor Yellow
    $verified = $false
}

if ($verified) {
    Write-Host "`nAll components are verified and operational!" -ForegroundColor Green
}
Write-Host "`nHow to use:" -ForegroundColor Cyan
Write-Host "  1. Double-click 'Video Compressor Pro' on your Desktop (or drop videos onto it)" -ForegroundColor White
Write-Host "  2. Right-click ANY video file in Windows Explorer -> 'Video Compressor Pro'" -ForegroundColor White
Write-Host "     (Non-video files like ZIP, PDF, images will remain clean with zero clutter!)" -ForegroundColor Gray
Write-Host ""
Read-Host "Press Enter to finish setup..."
exit 0

__PAYLOAD_ARCHIVE_DATA__
